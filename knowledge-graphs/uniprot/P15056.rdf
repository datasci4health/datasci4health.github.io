<rdf:type rdf:resource="http://purl.uniprot.org/core/Tissue_Specificity_Annotation"/>
<rdfs:comment>Brain and testis.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="P15056#SIP0B4CFC0A569BFF73">
<rdf:type rdf:resource="http://purl.uniprot.org/core/PTM_Annotation"/>
<rdfs:comment rdf:ID="_E79C218552482863_rdfs.comment_D6AF501BD99FF5DB">Phosphorylation at Ser-365 by SGK1 inhibits its activity (Ref.8, PubMed:11410590). Phosphorylation at Thr-753 by MAPK1 (PubMed:19710016). Dephosphorylation of Ser-365 by the SHOC2-MRAS-PP1c (SMP) complex consisting of SHOC2, GTP-bound M-Ras/MRAS and the catalytic subunit of protein phosphatase 1 (PPP1CA, PPP1CB or PPP1CC); this relieves inactivation and stimulates kinase activity (PubMed:35768504, PubMed:35830882).</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="#_E79C218552482863_rdfs.comment_D6AF501BD99FF5DB">
<attribution rdf:resource="P15056#attribution-330C7C642BB16DFCA086F63183C2ADF2"/>
