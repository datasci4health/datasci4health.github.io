<skos:altLabel>BRAF1</skos:altLabel>
<skos:altLabel>RAFB1</skos:altLabel>
</rdf:Description>
<rdf:Description rdf:about="#_D6F398706BBC7332_FFA56BCD0169E5A3_BRAF">
