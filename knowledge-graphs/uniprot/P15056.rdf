<rdf:type rdf:resource="http://purl.uniprot.org/core/Cofactor_Annotation"/>
<rdfs:comment rdf:ID="_68BA4F2A5D3B4867_rdfs.comment_5CD5CDB35D3B39DD">Binds 2 Zn(2+) ions per subunit.</rdfs:comment>
<cofactor rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29105" rdf:ID="_68BA4F2A5D3B4867_up.cofactor_87EBBCE0C6C068C3"/>
</rdf:Description>
