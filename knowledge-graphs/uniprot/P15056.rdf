<rdf:type rdf:resource="http://purl.uniprot.org/core/PTM_Annotation"/>
<rdfs:comment rdf:ID="_76767F6E3BED752E_rdfs.comment_324D1975089DA84E">Methylation at Arg-671 decreases stability and kinase activity.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="#_76767F6E3BED752E_rdfs.comment_324D1975089DA84E">
<attribution rdf:resource="P15056#attribution-A8EF1ABC0208F100A9AC7BA3C5D02A86"/>
</rdf:Description>
<rdf:Description rdf:about="P15056#SIP0978AC39A77E874E">
<rdf:type rdf:resource="http://purl.uniprot.org/core/PTM_Annotation"/>
<rdfs:comment rdf:ID="_9EEFED035E147FB4_rdfs.comment_6242289C625CE037">Ubiquitinated by RNF149; which leads to proteasomal degradation. Polyubiquitinated at Lys-578 in response to EGF.</rdfs:comment>
</rdf:Description>
