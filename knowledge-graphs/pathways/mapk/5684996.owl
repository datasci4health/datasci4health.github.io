  <bp:Protein rdf:ID="Protein203">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL5</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleukin-5</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL5_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference130" />
    <bp:feature rdf:resource="#FragmentFeature173" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 447159</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1056" />
