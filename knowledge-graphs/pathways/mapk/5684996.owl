  <bp:Protein rdf:ID="Protein171">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-7Y-KIT</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">autophosphorylated Kit</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference101" />
    <bp:feature rdf:resource="#ModificationFeature185" />
    <bp:feature rdf:resource="#ModificationFeature186" />
