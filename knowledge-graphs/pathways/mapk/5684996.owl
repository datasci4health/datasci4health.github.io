  <bp:Protein rdf:ID="Protein180">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACTN2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alpha-actinin-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACTN2_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference110" />
    <bp:feature rdf:resource="#FragmentFeature151" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 390562</bp:comment>
    <bp:xref rdf:resource="#UnificationXref937" />
