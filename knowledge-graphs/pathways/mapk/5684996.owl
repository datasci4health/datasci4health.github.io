  <bp:Protein rdf:ID="Protein107">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF19</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-19</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFJ_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
