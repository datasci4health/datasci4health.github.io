  <bp:PublicationXref rdf:ID="PublicationXref119">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8637718</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1996</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Activated Ras displaces 14-3-3 protein from the amino terminus of c-Raf-1</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rommel, C</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radziwill, G</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lovri?, J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Noeldeke, J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heinicke, T</bp:author>
