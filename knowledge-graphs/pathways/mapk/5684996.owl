  <bp:Protein rdf:ID="Protein157">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDGFRA</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-11Y-PDGFRA</bp:name>
