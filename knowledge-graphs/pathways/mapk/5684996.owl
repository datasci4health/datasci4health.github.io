  <bp:Protein rdf:ID="Protein4">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ras</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proHRAS</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p21/H-RAS-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transforming protein p21/H-Ras-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">c-H-ras</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference3" />
    <bp:feature rdf:resource="#FragmentFeature3" />
