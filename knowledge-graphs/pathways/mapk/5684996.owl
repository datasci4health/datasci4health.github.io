    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.1.3.16</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PP5 dephosphorylates RAF1 S338</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1804" />
    <bp:xref rdf:resource="#UnificationXref1805" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPP5C dephosphorylates S338 in the NtA region of RAF1, which reduces the catalytic activity of RAF1 towards MAP2K proteins (von Kriegsheim et al, 2006; reviewed in Matallanas et al, 2011).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref260" />
