  <bp:Protein rdf:ID="Protein422">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEM1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSS1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SHFM1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S proteasome complex subunit DSS1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSS1_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S proteasome complex subunit Rpn15</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference272" />
