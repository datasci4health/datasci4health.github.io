  <bp:Protein rdf:ID="Protein358">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBA52</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBA52(1-76)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ubiquitin (UBA52)</bp:name>
