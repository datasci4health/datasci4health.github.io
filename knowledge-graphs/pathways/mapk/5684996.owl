  <bp:Protein rdf:ID="Protein407">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMA3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proteasome subunit alpha-7</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference257" />
    <bp:feature rdf:resource="#FragmentFeature353" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 68728</bp:comment>
    <bp:xref rdf:resource="#UnificationXref2077" />
    <bp:xref rdf:resource="#UnificationXref2078" />
