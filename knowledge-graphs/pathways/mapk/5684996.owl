  <bp:Protein rdf:ID="Protein309">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CSK</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tyrosine-protein kinase CSK</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C-Src kinase</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference198" />
    <bp:feature rdf:resource="#FragmentFeature264" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 203776</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1537" />
