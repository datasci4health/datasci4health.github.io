  <bp:Protein rdf:ID="Protein204">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL5RA</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleukin-5 receptor subunit alpha</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL5RA_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference131" />
    <bp:feature rdf:resource="#FragmentFeature174" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 450072</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1061" />
    <bp:xref rdf:resource="#UnificationXref1062" />
