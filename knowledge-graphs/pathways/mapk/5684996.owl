    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RKTG sequesters B-Raf to the Golgi apparatus and inhibits the proliferation and tumorigenicity of human malignant melanoma cells</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fan, Fengjuan</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feng, Lin</bp:author>
