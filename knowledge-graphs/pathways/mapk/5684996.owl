  <bp:Protein rdf:ID="Protein190">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-JAK1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y-JAK1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated tyrosine-protein kinase JAK1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JAK1_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janus kinase 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference118" />
    <bp:feature rdf:resource="#ModificationFeature193" />
    <bp:feature rdf:resource="#FragmentFeature160" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 451921</bp:comment>
    <bp:xref rdf:resource="#UnificationXref994" />
