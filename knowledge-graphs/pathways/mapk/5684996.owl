  <bp:Protein rdf:ID="Protein237">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIK3CB</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI3-kinase p110 catalytic subunit beta</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphatidylinositol 3-kinase catalytic subunit, beta isoform (EC 2.7.1.137) (PI3-kinase p110 subunit beta) (PtdIns-3-kinase p110) (PI3K) (PI3Kbeta)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphatidylinositol-4,5-bisphosphate 3-kinase catalytic subunit, beta isoform</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
