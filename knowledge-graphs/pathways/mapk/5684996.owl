  <bp:Protein rdf:ID="Protein120">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCAM1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural cell adhesion molecule 1, 140 kDa isoform</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCA1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference67" />
    <bp:feature rdf:resource="#FragmentFeature100" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 190987</bp:comment>
