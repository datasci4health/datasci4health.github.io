  <bp:Protein rdf:ID="Protein132">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-ERBB4 JM-A CYT-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y1056,Y1188,Y1242-ERBB4 JM-A CYT-1 isoform</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-HER4 JM-A-CYT-1 isoform</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference76" />
    <bp:feature rdf:resource="#ModificationFeature111" />
    <bp:feature rdf:resource="#ModificationFeature112" />
    <bp:feature rdf:resource="#ModificationFeature113" />
    <bp:feature rdf:resource="#FragmentFeature109" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1250319</bp:comment>
    <bp:xref rdf:resource="#UnificationXref662" />
