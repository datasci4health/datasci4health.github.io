    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleukin-2 receptor alpha chain</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL2RA_HUMAN</bp:name>
