  <bp:Protein rdf:ID="Protein119">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PTPRA</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Receptor-type tyrosine-protein phosphatase alpha</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PTPRA_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference66" />
    <bp:feature rdf:resource="#FragmentFeature99" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 388755</bp:comment>
    <bp:xref rdf:resource="#UnificationXref616" />
    <bp:xref rdf:resource="#UnificationXref617" />
