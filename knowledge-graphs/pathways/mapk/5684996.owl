  <bp:Protein rdf:ID="Protein287">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEK2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-S222,S226-MAP2K2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phospho-MEK2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dual specificity mitogen-activated protein kinase kinase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP kinase kinase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPKK 2</bp:name>
