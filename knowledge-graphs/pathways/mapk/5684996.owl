  <bp:PublicationXref rdf:ID="PublicationXref273">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15851477</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2005</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Essential role of p38gamma in K-Ras transformation independent of phosphorylation</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tang, Jun</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qi, Xiaomei</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mercola, Dan</bp:author>
