  <bp:Protein rdf:ID="Protein139">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-EGFR</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phospho-EGFR</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated Epidermal Growth Factor Receptor</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference82" />
    <bp:feature rdf:resource="#ModificationFeature128" />
    <bp:feature rdf:resource="#ModificationFeature129" />
    <bp:feature rdf:resource="#ModificationFeature130" />
    <bp:feature rdf:resource="#ModificationFeature131" />
    <bp:feature rdf:resource="#ModificationFeature132" />
    <bp:feature rdf:resource="#ModificationFeature133" />
    <bp:feature rdf:resource="#FragmentFeature116" />
