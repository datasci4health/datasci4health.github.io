  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction63">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex205" />
    <bp:left rdf:resource="#Protein279" />
    <bp:right rdf:resource="#Complex204" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRAP binds KSR1:MARK3</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1876" />
    <bp:xref rdf:resource="#UnificationXref1877" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRAP is a negative regulator of MAPK signaling that binds KSR1 as assessed by coimmunoprecipitation. This interaction abrogates KSR1 homodimer and KSR1:RAF heterodimer formation, and disrupts the recruitment of MAP2K kinases to RAF (Methany et al, 2004; Chen et al, 2008; reviewed in Methany et al, 2009). BRAP inhibition of  KSR1 is relieved in an unknown manner by autoubiquitination after RAS pathway activation (reviewed in Methany et al, 2009).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref263" />
    <bp:xref rdf:resource="#PublicationXref264" />
    <bp:xref rdf:resource="#PublicationXref265" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2015-02-06</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Roskoski, Robert Jr, 2015-04-28</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2015-02-12</bp:comment>
  </bp:BiochemicalReaction>
