  <bp:Protein rdf:ID="Protein36">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZDHHC9</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Palmitoyltransferase ZDHHC9 ecNumber2.3.1.225/ecNumber</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZDHC9_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference11" />
    <bp:feature rdf:resource="#FragmentFeature30" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9647931</bp:comment>
