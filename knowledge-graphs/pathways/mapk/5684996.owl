  <bp:Protein rdf:ID="Protein314">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAP1B</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ras-related protein Rap-1B</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference201" />
    <bp:feature rdf:resource="#FragmentFeature268" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 377590</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1552" />
    <bp:xref rdf:resource="#UnificationXref1553" />
