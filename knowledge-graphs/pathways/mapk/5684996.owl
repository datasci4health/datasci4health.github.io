  <bp:Protein rdf:ID="Protein168">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RasGRP</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-T184-RASGRP1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RASGRP1 phosphorylated at threonine-184</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CalDAG-GEFII</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAS guanyl-releasing protein 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRP1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference98" />
    <bp:feature rdf:resource="#ModificationFeature183" />
    <bp:feature rdf:resource="#FragmentFeature139" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1169559</bp:comment>
    <bp:xref rdf:resource="#UnificationXref877" />
