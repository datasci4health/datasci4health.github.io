  <bp:Protein rdf:ID="Protein3">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proNRAS</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p21/N-Ras</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transforming protein N-Ras</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference2" />
    <bp:feature rdf:resource="#FragmentFeature2" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9647758</bp:comment>
