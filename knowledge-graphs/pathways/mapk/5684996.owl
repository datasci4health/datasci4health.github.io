  <bp:Protein rdf:ID="Protein101">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFR3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-FGFR3b</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-FGFR3-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phosphorylated FGFR3b</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated Fibroblast growth factor receptor 3b</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGR3_HUMAN</bp:name>
