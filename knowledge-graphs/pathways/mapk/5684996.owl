  <bp:Protein rdf:ID="Protein23">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DUB-3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USP17L2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ubiquitin carboxyl-terminal hydrolase 17</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">U17L2_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference9" />
    <bp:feature rdf:resource="#FragmentFeature20" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 6782780</bp:comment>
    <bp:xref rdf:resource="#UnificationXref120" />
