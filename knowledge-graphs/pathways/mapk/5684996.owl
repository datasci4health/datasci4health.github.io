    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2012</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct and indirect control of mitogen-activated protein kinase pathway-associated components, BRAP/IMP E3 ubiquitin ligase and CRAF/RAF1 kinase, by the deubiquitylating enzyme USP15</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hayes, Sebastian D</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Liu, H</bp:author>
