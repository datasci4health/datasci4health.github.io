    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase 3 (EC 2.7.1.-) (Extracellular signal- regulated kinase 1) (ERK-1) (Insulin-stimulated MAP2 kinase) (MAP kinase 1) (MAPK 1) (p44-ERK1) (ERT2) (p44-MAPK) (Microtubule- associated protein-2 kinase)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase 3</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extracellular signal-regulated kinase 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERK-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insulin-stimulated MAP2 kinase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP kinase 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPK 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p44-ERK1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERT2</bp:name>
