  <bp:Protein rdf:ID="Protein406">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMA6</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proteasome subunit alpha-1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference256" />
    <bp:feature rdf:resource="#FragmentFeature352" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 68734</bp:comment>
