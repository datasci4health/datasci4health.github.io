  <bp:Protein rdf:ID="Protein246">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRAF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-S365,S446,S729 BRAF</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">B-RAF</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference161" />
    <bp:feature rdf:resource="#ModificationFeature221" />
    <bp:feature rdf:resource="#ModificationFeature222" />
    <bp:feature rdf:resource="#ModificationFeature223" />
    <bp:feature rdf:resource="#FragmentFeature208" />
