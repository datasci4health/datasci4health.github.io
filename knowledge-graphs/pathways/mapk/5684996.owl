  <bp:Protein rdf:ID="Protein267">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SHOC2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leucine-rich repeat protein SHOC-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SHOC2_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference174" />
    <bp:feature rdf:resource="#FragmentFeature224" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9658444</bp:comment>
