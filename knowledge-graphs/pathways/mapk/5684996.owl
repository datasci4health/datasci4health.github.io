    <bp:xref rdf:resource="#PublicationXref105" />
    <bp:xref rdf:resource="#PublicationXref106" />
    <bp:xref rdf:resource="#PublicationXref107" />
    <bp:xref rdf:resource="#PublicationXref108" />
