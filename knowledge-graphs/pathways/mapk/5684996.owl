  <bp:Protein rdf:ID="Protein127">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NRG1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuregulin-1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference72" />
    <bp:feature rdf:resource="#FragmentFeature105" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1227951</bp:comment>
    <bp:xref rdf:resource="#UnificationXref646" />
    <bp:xref rdf:resource="#UnificationXref647" />
