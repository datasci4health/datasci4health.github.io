  <bp:Protein rdf:ID="Protein312">
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Converted from EntitySet in Reactome</bp:comment>
    <bp:memberPhysicalEntity rdf:resource="#Protein313" />
