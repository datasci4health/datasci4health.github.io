  <bp:Protein rdf:ID="Protein213">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTN</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Artemin</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTN_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference137" />
