  <bp:Protein rdf:ID="Protein397">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMB4</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proteasome subunit beta-7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proteasome subunit beta-7</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference247" />
    <bp:feature rdf:resource="#FragmentFeature343" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 68750</bp:comment>
    <bp:xref rdf:resource="#UnificationXref2045" />
