    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1999</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The N-terminal ERK-binding site of MEK1 is required for efficient feedback phosphorylation by ERK2 in vitro and ERK activation in vivo</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xu, Bing-e</bp:author>
