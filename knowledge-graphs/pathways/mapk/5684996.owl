  <bp:Protein rdf:ID="Protein178">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRIN1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glutamate (NMDA) receptor subunit zeta-1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference108" />
    <bp:feature rdf:resource="#FragmentFeature149" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 419564</bp:comment>
