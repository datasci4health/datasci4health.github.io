  <bp:Protein rdf:ID="Protein317">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERK2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPK1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase 1 (EC 2.7.1.-) (Extracellular signal- regulated kinase 2) (ERK-2) (Mitogen-activated protein kinase 2) (MAP kinase 2) (MAPK 2) (p42-MAPK) (ERT1)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extracellular signal-regulated kinase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP kinase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPK 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p42-MAPK</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERT1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERK-2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference203" />
    <bp:feature rdf:resource="#FragmentFeature270" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 59282</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1588" />
    <bp:xref rdf:resource="#UnificationXref1589" />
