    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP2Ks and MAPKs are phosphorylated at the endosome membrane</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1721" />
    <bp:xref rdf:resource="#UnificationXref1722" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interaction of MAPK pathway components with LAMTOR2, 3 and MORG1 facilitates pathway activation in response to varied stimuli, resulting in the phosphorylation of MAP2K and MAPK proteins at conserved sites in their activation loops (Schaeffer et al, 1998; Teis et al, 2002; Teis et al, 2006; Vomastek et al, 2004; Sharma et al, 2005; reviewed in Matallanas et al, 2011).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref223" />
    <bp:xref rdf:resource="#PublicationXref224" />
    <bp:xref rdf:resource="#PublicationXref118" />
    <bp:xref rdf:resource="#PublicationXref225" />
    <bp:xref rdf:resource="#PublicationXref227" />
    <bp:xref rdf:resource="#PublicationXref226" />
