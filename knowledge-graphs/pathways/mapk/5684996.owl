    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMC4</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S protease regulatory subunit 6B</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MIP224</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MB67 interacting protein</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAT-binding protein-7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBP-7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S proteasome AAA-ATPase subunit RPT3</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
