  <bp:Protein rdf:ID="Protein77">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF5-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-5 isoform 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF5_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference33" />
    <bp:feature rdf:resource="#FragmentFeature65" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 189903</bp:comment>
