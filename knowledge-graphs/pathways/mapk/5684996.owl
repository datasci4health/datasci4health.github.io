    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CSF2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Granulocyte-macrophage colony-stimulating factor</bp:name>
