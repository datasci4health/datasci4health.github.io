  <bp:Protein rdf:ID="Protein331">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PEA15</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference210" />
