  <bp:Protein rdf:ID="Protein306">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VWF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VWF(23-763)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Von Willebrand factor precursor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vWF</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference195" />
    <bp:feature rdf:resource="#FragmentFeature261" />
