  <bp:Protein rdf:ID="Protein47">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">APT1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LYPLA1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference14" />
    <bp:feature rdf:resource="#FragmentFeature39" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 203713</bp:comment>
    <bp:xref rdf:resource="#UnificationXref215" />
