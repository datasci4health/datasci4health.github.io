  <bp:Protein rdf:ID="Protein217">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-RET</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proto-oncogene tyrosine-protein kinase receptor Ret ecNumber2.7.10.1/ecNumber</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RET_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference140" />
