  <bp:Protein rdf:ID="Protein215">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GFRA1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GDNF family receptor alpha-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GFRA1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference138" />
