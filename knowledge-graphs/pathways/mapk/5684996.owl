    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UniProt:Q5VST6 ABHD17B</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABHD17B</bp:name>
