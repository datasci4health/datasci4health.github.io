  <bp:Protein rdf:ID="Protein268">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S-GGC MRAS</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ras-related protein M-Ras</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RASM_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference175" />
