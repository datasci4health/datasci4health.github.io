  <bp:Protein rdf:ID="Protein244">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cRaf</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-S259,S621-RAF1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAF proto-oncogene serine/threonine-protein kinase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raf-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C-RAF</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference159" />
    <bp:feature rdf:resource="#ModificationFeature217" />
    <bp:feature rdf:resource="#ModificationFeature218" />
    <bp:feature rdf:resource="#FragmentFeature206" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 109786</bp:comment>
