  <bp:Protein rdf:ID="Protein92">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFR2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-8Y-FGFR2-3</bp:name>
