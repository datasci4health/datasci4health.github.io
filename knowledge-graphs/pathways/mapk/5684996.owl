  <bp:Protein rdf:ID="Protein233">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIK3R1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI3K p85 alpha</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphatidylinositol 3-kinase regulatory alpha subunit</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI3-kinase p85-alpha subunit</bp:name>
