  <bp:Protein rdf:ID="Protein86">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KL-2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Klotho isoform 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KLOT_HUMAN</bp:name>
