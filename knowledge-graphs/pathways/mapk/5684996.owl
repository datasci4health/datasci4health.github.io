  <bp:Protein rdf:ID="Protein121">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pFyn-Y420</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y420-FYN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference68" />
    <bp:feature rdf:resource="#ModificationFeature110" />
    <bp:feature rdf:resource="#FragmentFeature101" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 391821</bp:comment>
    <bp:xref rdf:resource="#UnificationXref626" />
