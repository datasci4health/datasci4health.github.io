  <bp:Protein rdf:ID="Protein125">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HBEGF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HBEGF(63-148)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HB-EGF</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heparin-binding EGF-like growth factors</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference71" />
    <bp:feature rdf:resource="#FragmentFeature104" />
