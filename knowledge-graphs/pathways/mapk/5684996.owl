  <bp:Protein rdf:ID="Protein411">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMC1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S protease regulatory subunit 4</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P26s4</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6S proteasome AAA-ATPase subunit RPT2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference261" />
    <bp:feature rdf:resource="#FragmentFeature357" />
