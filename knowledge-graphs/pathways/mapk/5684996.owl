  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction60">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex260" />
    <bp:left rdf:resource="#SmallMolecule10" />
    <bp:right rdf:resource="#SmallMolecule33" />
    <bp:right rdf:resource="#Complex261" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.1.3.16</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PP2A dephosphorylates RAF1</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1810" />
    <bp:xref rdf:resource="#UnificationXref1811" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Along with PPP5C-mediated dephophosphorylation of the NtA region, PP2A contributes to the inactivation of RAF1 by mediating the dephosphorylation of AL loop residues.  PP2A-mediated dephosphorylation of RAF1 may be stimulated by the prior hyperphosphorylation of RAF1 by MAPKs (Dougherty et al, 2005; reviewed in Matallanas et al, 2011).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref251" />
    <bp:xref rdf:resource="#PublicationXref118" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2015-02-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Roskoski, Robert Jr, 2015-04-28</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2015-02-15</bp:comment>
  </bp:BiochemicalReaction>
