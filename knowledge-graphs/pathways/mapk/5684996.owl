  <bp:Protein rdf:ID="Protein225">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-4Y-MET</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y1234,Y1235,Y1349,Y1356-MET</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference146" />
    <bp:feature rdf:resource="#ModificationFeature207" />
