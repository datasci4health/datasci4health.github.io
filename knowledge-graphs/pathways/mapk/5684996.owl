  <bp:Protein rdf:ID="Protein134">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-ERBB2</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
