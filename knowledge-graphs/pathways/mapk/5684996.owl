  <bp:Protein rdf:ID="Protein172">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEFL</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neurofilament light polypeptide</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NFL_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference102" />
    <bp:feature rdf:resource="#FragmentFeature143" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 432284</bp:comment>
    <bp:xref rdf:resource="#UnificationXref899" />
    <bp:xref rdf:resource="#UnificationXref900" />
