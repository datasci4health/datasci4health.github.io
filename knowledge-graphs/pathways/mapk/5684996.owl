  <bp:Protein rdf:ID="Protein350">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DUSP1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dual specificity protein phosphatase 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DUS1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary8" />
    <bp:entityReference rdf:resource="#ProteinReference220" />
    <bp:feature rdf:resource="#FragmentFeature298" />
