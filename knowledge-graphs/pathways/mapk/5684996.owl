  <bp:Protein rdf:ID="Protein234">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIK3R2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI3K-p85 beta</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphatidylinositol 3-kinase regulatory beta subunit</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI3-kinase p85-beta subunit</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PtdIns-3-kinase p85-beta</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference152" />
    <bp:feature rdf:resource="#FragmentFeature199" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 74791</bp:comment>
