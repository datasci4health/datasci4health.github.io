  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction47">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex245" />
    <bp:left rdf:resource="#Complex246" />
    <bp:left rdf:resource="#Complex219" />
    <bp:left rdf:resource="#Protein316" />
    <bp:right rdf:resource="#Complex247" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WDR83:LAMTOR2:LAMTOR3 binds MAPK components</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1717" />
    <bp:xref rdf:resource="#UnificationXref1718" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAMTOR3 (also known as MEK partner 1, MP1) exists in an obligatory complex with LAMTOR2 (p14) at the endosomal membrane where they act as a scaffold and promote MAPK activation (Schaeffer et al, 1998; Teis et al, 2002; Teis et al, 2006; Sharma et al, 2005). The LAMTOR2/LAMTOR3 complex may also be part of a larger molecular weight complex at the endosome that includes the MAPK organizer protein MORG1 (Vomastek et al, 2004; Sharma et al, 2005; reviewed in Matallanas et al, 2011).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref223" />
    <bp:xref rdf:resource="#PublicationXref224" />
    <bp:xref rdf:resource="#PublicationXref118" />
    <bp:xref rdf:resource="#PublicationXref225" />
    <bp:xref rdf:resource="#PublicationXref226" />
    <bp:xref rdf:resource="#PublicationXref227" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2015-02-10</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Roskoski, Robert Jr, 2015-04-28</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2015-02-12</bp:comment>
  </bp:BiochemicalReaction>
