  <bp:Protein rdf:ID="Protein340">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DUSP6</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dual specificity protein phosphatase 6 ecNumber3.1.3.16/ecNumber ecNumber3.1.3.48/ecNumber</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DUS6_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference213" />
    <bp:feature rdf:resource="#FragmentFeature289" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5675343</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1821" />
    <bp:xref rdf:resource="#UnificationXref1822" />
