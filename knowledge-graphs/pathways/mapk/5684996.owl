  <bp:Protein rdf:ID="Protein177">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NR2B</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRIN2B</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glutamate (NMDA) receptor subunit epsilon-2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference107" />
    <bp:feature rdf:resource="#FragmentFeature148" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 419558</bp:comment>
