    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aitken, A</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moelling, K</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oncogene 12:609-19</bp:source>
  </bp:PublicationXref>
