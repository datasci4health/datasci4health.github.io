  <bp:Pathway rdf:ID="Pathway11">
    <bp:pathwayComponent rdf:resource="#BiochemicalReaction80" />
    <bp:pathwayComponent rdf:resource="#BiochemicalReaction81" />
    <bp:pathwayComponent rdf:resource="#BiochemicalReaction82" />
