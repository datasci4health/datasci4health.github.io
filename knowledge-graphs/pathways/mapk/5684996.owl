  <bp:Protein rdf:ID="Protein229">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RANBP9</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RanBPM</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ran-binding protein 9</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RANB9_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference148" />
    <bp:feature rdf:resource="#FragmentFeature195" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 374586</bp:comment>
