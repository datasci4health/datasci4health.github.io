  <bp:Protein rdf:ID="Protein170">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sSCF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KITLG-1(26-190)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soluble SCF</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference100" />
    <bp:feature rdf:resource="#FragmentFeature141" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 708330</bp:comment>
