  <bp:Protein rdf:ID="Protein389">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPRED1</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference240" />
    <bp:feature rdf:resource="#FragmentFeature335" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5658225</bp:comment>
