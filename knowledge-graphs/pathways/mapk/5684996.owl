  <bp:Protein rdf:ID="Protein220">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NRTN</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neurturin</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NRTN_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference142" />
    <bp:feature rdf:resource="#FragmentFeature187" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 434904</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1122" />
