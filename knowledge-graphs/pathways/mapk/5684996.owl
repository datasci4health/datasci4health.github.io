  </bp:BiochemicalReaction>
  <bp:Protein rdf:ID="Protein56">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BCL2L1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apoptosis regulator Bcl-X</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bcl-2-like 1 protein</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary5" />
    <bp:entityReference rdf:resource="#ProteinReference19" />
    <bp:feature rdf:resource="#FragmentFeature47" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 114236</bp:comment>
    <bp:xref rdf:resource="#UnificationXref289" />
    <bp:xref rdf:resource="#UnificationXref290" />
