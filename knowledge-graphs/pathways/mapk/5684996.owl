  <bp:Protein rdf:ID="Protein5">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pro-KRAS4A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GTPase KRas</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RASK_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference4" />
    <bp:feature rdf:resource="#FragmentFeature4" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9649683</bp:comment>
    <bp:xref rdf:resource="#UnificationXref16" />
