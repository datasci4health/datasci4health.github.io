    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intrinsic GTPase activity distinguishes normal and oncogenic ras p21 molecules</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gibbs, Jackson B</bp:author>
