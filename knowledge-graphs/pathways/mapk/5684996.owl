  <bp:Protein rdf:ID="Protein144">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NRG1-10</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NRG1 SMDF</bp:name>
