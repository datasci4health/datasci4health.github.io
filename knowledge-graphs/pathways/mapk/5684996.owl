    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRAP autoubiquitinates</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1920" />
    <bp:xref rdf:resource="#UnificationXref1921" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Binding to activated RAS stimulates the ubiquitinase activity of BRAP, promoting autoubiquitination and relieving the inhibition of KSR1 (Methany et al, 2004; Chen et al, 2008; Methany et al, 2009).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref263" />
    <bp:xref rdf:resource="#PublicationXref264" />
    <bp:xref rdf:resource="#PublicationXref265" />
