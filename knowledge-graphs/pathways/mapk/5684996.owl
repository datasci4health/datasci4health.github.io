  <bp:Protein rdf:ID="Protein435">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gp130</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-IL6ST-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tyrosine phosphorylated Interleukin-6 receptor subunit beta long transmembrane form</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6RB_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6ST</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-IL6ST isoform 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference281" />
