  <bp:Protein rdf:ID="Protein301">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VCL</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vinculin</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference190" />
    <bp:feature rdf:resource="#FragmentFeature256" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 350753</bp:comment>
