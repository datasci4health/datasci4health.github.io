  <bp:Protein rdf:ID="Protein307">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITGB3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrin beta3</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Platelet membrane glycoprotein IIIa</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPIIIa</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CD61 antigen</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference196" />
    <bp:feature rdf:resource="#FragmentFeature262" />
