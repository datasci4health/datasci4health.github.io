  <bp:Protein rdf:ID="Protein256">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPP2CA</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PP2A-catalytic subunit C alpha isoform</bp:name>
