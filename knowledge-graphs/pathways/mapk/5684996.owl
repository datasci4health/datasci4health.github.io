  <bp:Protein rdf:ID="Protein104">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFR3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-FGFR3c</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-FGFR3-1(23-808)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phosphorylated FGFR3c</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated Fibroblast growth factor receptor 3c</bp:name>
