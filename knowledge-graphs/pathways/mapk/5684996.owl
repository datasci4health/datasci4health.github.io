  <bp:Protein rdf:ID="Protein138">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EGF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Epidermal Growth Factor</bp:name>
