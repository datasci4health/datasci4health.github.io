    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protransforming growth factor alpha  component recommendedName: Transforming growth factor alpha</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference88" />
