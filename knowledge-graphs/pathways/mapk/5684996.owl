  <bp:Protein rdf:ID="Protein187">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RASGRF1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ras-specific guanine nucleotide-releasing factor 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RGRF1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference116" />
    <bp:feature rdf:resource="#FragmentFeature157" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 442723</bp:comment>
    <bp:xref rdf:resource="#UnificationXref978" />
