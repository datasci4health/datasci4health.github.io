  <bp:Protein rdf:ID="Protein285">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MyrG-p-Y419-SRC</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y419-N-myristoyl-SRC</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
