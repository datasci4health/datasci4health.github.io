  <bp:Protein rdf:ID="Protein83">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF23</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GalNAc-T178-FGF23(25-251)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-23</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFN_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference39" />
    <bp:feature rdf:resource="#ModificationFeature38" />
    <bp:feature rdf:resource="#FragmentFeature71" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 8851633</bp:comment>
