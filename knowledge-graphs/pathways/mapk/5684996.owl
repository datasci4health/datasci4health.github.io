  <bp:PublicationXref rdf:ID="PublicationXref77">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">22750304</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2012</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Probing the GTPase cycle with real-time NMR: GAP and GEF activities in cell extracts</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marshall, Christopher B</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meiri, David</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smith, Matthew J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mazhab-Jafari, Mohammad T</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gasmi-Seabrook, Geneviève M C</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rottapel, Robert</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stambolic, Vuk</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ikura, Mitsuhiko</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methods 57:473-85</bp:source>
  </bp:PublicationXref>
