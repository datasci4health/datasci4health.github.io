  <bp:Protein rdf:ID="Protein357">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RPS27A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RPS27A(1-76)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ubiquitin (RPS27A)</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference223" />
    <bp:feature rdf:resource="#FragmentFeature304" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 939205</bp:comment>
