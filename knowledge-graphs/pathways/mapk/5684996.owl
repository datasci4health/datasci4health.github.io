  <bp:Protein rdf:ID="Protein441">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PTPN11</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y542,Y580-PTPN11</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p(Y542,580)-SHP2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tyrosine phosphorylated SHP2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference284" />
