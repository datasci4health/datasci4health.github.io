  <bp:Protein rdf:ID="Protein433">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleukin-6</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference279" />
    <bp:feature rdf:resource="#FragmentFeature377" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 447100</bp:comment>
