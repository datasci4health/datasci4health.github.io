  <bp:Protein rdf:ID="Protein440">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sIL6R</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6R-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleukin-6 receptor subunit alpha short soluble form</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IL6RA_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference283" />
    <bp:feature rdf:resource="#FragmentFeature383" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1067661</bp:comment>
    <bp:xref rdf:resource="#UnificationXref2218" />
