  <bp:Protein rdf:ID="Protein308">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPIIb</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITGA2B(32-1039)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrin alpha2b</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrin alpha-IIb</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Platelet membrane glycoprotein IIb</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPalpha IIb</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CD41 antigen</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference197" />
    <bp:feature rdf:resource="#FragmentFeature263" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 57578</bp:comment>
