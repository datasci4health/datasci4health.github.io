  <bp:Protein rdf:ID="Protein111">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPTB</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectrin beta chain, erythrocyte</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPTB1_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Beta-I spectrin</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference59" />
    <bp:feature rdf:resource="#FragmentFeature92" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 391565</bp:comment>
