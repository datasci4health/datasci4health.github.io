  <bp:Protein rdf:ID="Protein69">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF2(143-288)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heparin-binding growth factor 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF2_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Basic fibroblast growth factor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bFGF</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference26" />
    <bp:feature rdf:resource="#FragmentFeature58" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 189898</bp:comment>
