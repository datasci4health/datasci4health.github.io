  <bp:Protein rdf:ID="Protein273">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-S311,Y602 KSR1</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference176" />
    <bp:feature rdf:resource="#ModificationFeature235" />
    <bp:feature rdf:resource="#ModificationFeature236" />
    <bp:feature rdf:resource="#FragmentFeature229" />
