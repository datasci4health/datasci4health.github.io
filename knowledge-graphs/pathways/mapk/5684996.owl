  <bp:Protein rdf:ID="Protein21">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PolyUb-RCE1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAAX prenyl protease 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FACE2_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference8" />
