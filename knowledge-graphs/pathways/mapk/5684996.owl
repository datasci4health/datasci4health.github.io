  <bp:Protein rdf:ID="Protein266">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PP1CC</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPP1CC</bp:name>
