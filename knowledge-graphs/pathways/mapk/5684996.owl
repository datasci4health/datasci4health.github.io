  <bp:Protein rdf:ID="Protein109">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-PTK2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p(Y397,407,576,577,861,925)-FADK 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p(Y397,407,576,577,861,925)-PTK2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference58" />
