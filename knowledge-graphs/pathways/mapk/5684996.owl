  <bp:Protein rdf:ID="Protein337">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPP5C</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference212" />
    <bp:feature rdf:resource="#FragmentFeature287" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5675402</bp:comment>
