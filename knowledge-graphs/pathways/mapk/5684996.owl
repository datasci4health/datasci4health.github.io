  <bp:Protein rdf:ID="Protein277">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MLK3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP3K11</bp:name>
