  <bp:Protein rdf:ID="Protein133">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-ERBB4 JM-B CYT-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y1046,Y1178,Y1232-ERBB4 JM-B CYT-1 isoform</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-HER4 JM-B CYT-1 isoform</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference77" />
    <bp:feature rdf:resource="#ModificationFeature114" />
    <bp:feature rdf:resource="#ModificationFeature115" />
    <bp:feature rdf:resource="#ModificationFeature116" />
    <bp:feature rdf:resource="#FragmentFeature110" />
