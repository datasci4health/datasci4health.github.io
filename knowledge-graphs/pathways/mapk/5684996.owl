  <bp:Protein rdf:ID="Protein148">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IRS-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y-IRS1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-IRS1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insulin receptor substrate-1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference85" />
    <bp:feature rdf:resource="#ModificationFeature146" />
