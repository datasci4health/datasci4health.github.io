  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction9">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule10" />
    <bp:left rdf:resource="#Protein38" />
    <bp:right rdf:resource="#SmallMolecule17" />
    <bp:right rdf:resource="#Protein42" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.1.2.22</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAS proteins are depalmitoylated</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref227" />
    <bp:xref rdf:resource="#UnificationXref228" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAS proteins undergo a dynamic palmitoylation and depalmitoylation cycle that regulates their association with membranes and thus their localization and function (Hancock et al, 1989; Swarthout et al, 2005; reviewed in Gysin et al, 2011; Lin et al, 2017; Ahearn et al, 2018). Depalmitoylation is catalyzed by the acyl-protein thioesterase LYPLA1, also known as APT1, or by members of the ABHD17 family (Dekker et al, 2010; Lin and Conibear, 2015; reviewed in Lin et al, 2017).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref2" />
    <bp:xref rdf:resource="#PublicationXref33" />
    <bp:xref rdf:resource="#PublicationXref8" />
    <bp:xref rdf:resource="#PublicationXref35" />
    <bp:xref rdf:resource="#PublicationXref34" />
    <bp:xref rdf:resource="#PublicationXref36" />
    <bp:xref rdf:resource="#PublicationXref37" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2019-10-25</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Gavathiotis, Evripidis, 2020-05-04</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2020-05-26</bp:comment>
  </bp:BiochemicalReaction>
