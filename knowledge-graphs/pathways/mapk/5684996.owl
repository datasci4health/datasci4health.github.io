  <bp:PathwayStep rdf:ID="PathwayStep38">
    <bp:stepProcess rdf:resource="#BiochemicalReaction37" />
    <bp:nextStep rdf:resource="#PathwayStep41" />
    <bp:stepProcess rdf:resource="#Catalysis14" />
  </bp:PathwayStep>
  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction38">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#PhysicalEntity25" />
    <bp:left rdf:resource="#Complex203" />
    <bp:right rdf:resource="#Complex218" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raf dimer inhibitors bind RAF heterodimers</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1467" />
    <bp:xref rdf:resource="#UnificationXref1468" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LY3009120, TAK-580 and TAK-632 are pan-RAF inhibitors that binds to all 3 RAF isoforms as well as to RAF dimers to inhibit phosphorylation of MAP2K and MAPK proteins (Nakamura et al, 2013; Okaniwa et al, 2013; Sun et al, 2017; Peng et al, 2015; Henry et al, 2015; Vakana et al, 2017). Because they inhibit the kinase activity of RAF homo- and heterodimers, treatment with pan-RAF dimer inhibitors generates minimal paradoxical RAF activation and inhibits cellular proliferation in a number of tumor models (Peng et al, 2015; Henry et al, 2015, Vakana et al, 2017; reviewed in Karoulia et al, 2017; Agianian and Gavathiotis, 2018; ).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref163" />
    <bp:xref rdf:resource="#PublicationXref164" />
    <bp:xref rdf:resource="#PublicationXref165" />
    <bp:xref rdf:resource="#PublicationXref166" />
    <bp:xref rdf:resource="#PublicationXref167" />
    <bp:xref rdf:resource="#PublicationXref168" />
    <bp:xref rdf:resource="#PublicationXref169" />
    <bp:xref rdf:resource="#PublicationXref170" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2019-10-25</bp:comment>
