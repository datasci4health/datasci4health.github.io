  <bp:Protein rdf:ID="Protein182">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAMK2A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAMKIIalpha</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KIAA0968</bp:name>
