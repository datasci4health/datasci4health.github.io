  <bp:Protein rdf:ID="Protein165">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pTEK</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y,S1119-TEK</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-TEK</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated angiopoietin 1 receptor</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference96" />
