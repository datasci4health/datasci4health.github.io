  <bp:Protein rdf:ID="Protein85">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KL-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Klotho isoform 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KLOT_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference40" />
    <bp:feature rdf:resource="#FragmentFeature73" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 190198</bp:comment>
    <bp:xref rdf:resource="#UnificationXref430" />
    <bp:xref rdf:resource="#UnificationXref431" />
