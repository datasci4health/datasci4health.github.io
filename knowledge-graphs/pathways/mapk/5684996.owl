  <bp:Protein rdf:ID="Protein105">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFR4</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-FGFR4</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phosphorylated FGFR4</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphorylated Fibroblast growth factor receptor 4</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGR4_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference55" />
    <bp:feature rdf:resource="#ModificationFeature99" />
    <bp:feature rdf:resource="#ModificationFeature100" />
    <bp:feature rdf:resource="#ModificationFeature101" />
    <bp:feature rdf:resource="#ModificationFeature102" />
    <bp:feature rdf:resource="#ModificationFeature103" />
    <bp:feature rdf:resource="#FragmentFeature88" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 190330</bp:comment>
    <bp:xref rdf:resource="#UnificationXref555" />
