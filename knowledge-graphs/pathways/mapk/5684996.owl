  <bp:Protein rdf:ID="Protein379">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DAB2IP</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference230" />
    <bp:feature rdf:resource="#FragmentFeature325" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5658238</bp:comment>
    <bp:xref rdf:resource="#UnificationXref1966" />
