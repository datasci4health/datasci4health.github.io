  <bp:Protein rdf:ID="Protein260">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPP2R5B</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serine/threonine-protein phosphatase 2A 56 kDa regulatory subunit beta isoform</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2A5B_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference168" />
    <bp:feature rdf:resource="#FragmentFeature218" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 535469</bp:comment>
