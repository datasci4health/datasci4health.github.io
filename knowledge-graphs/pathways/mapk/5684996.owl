  <bp:Protein rdf:ID="Protein80">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF9</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-9</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glia-activating factor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF9_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference36" />
    <bp:feature rdf:resource="#FragmentFeature68" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 189870</bp:comment>
