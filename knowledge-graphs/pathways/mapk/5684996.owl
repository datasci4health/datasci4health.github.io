    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.7.12.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAP2Ks phosphorylate MAPK at the Golgi membrane</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1732" />
    <bp:xref rdf:resource="#UnificationXref1733" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Activated MAP2Ks in complex with IL17RD phosphorylate MAPKs at the Golgi membrane.  IL17RD prevents the dissociation of phosphorylated MAPK from the complex at the Golgi as assessed by coimmunoprecipitation, preventing MAPK nuclear translocation and activation of nuclear targets (Torii et al, 2004; reviewed in Philips, 2004; Brown and Sacks, 2009).</bp:comment>
