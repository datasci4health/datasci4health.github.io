  <bp:Protein rdf:ID="Protein108">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KLB</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BetaKlotho</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference57" />
    <bp:feature rdf:resource="#FragmentFeature90" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1307932</bp:comment>
    <bp:xref rdf:resource="#UnificationXref565" />
