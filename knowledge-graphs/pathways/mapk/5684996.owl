  <bp:Protein rdf:ID="Protein173">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DLG1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SAP-97</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disks large homolog 1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DLG1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference103" />
    <bp:feature rdf:resource="#FragmentFeature144" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 375977</bp:comment>
    <bp:xref rdf:resource="#UnificationXref902" />
