    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPK3 (ERK1) activation</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref2241" />
    <bp:xref rdf:resource="#UnificationXref2242" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitogen-activated protein kinase kinase MAP2K1 (also known as MEK1) is a dual threonine and tyrosine recognition kinase that phosphorylates and activates MAPK3 (ERK1) (Ohren et al. 2004; Roskoski 2012a).</bp:comment>
