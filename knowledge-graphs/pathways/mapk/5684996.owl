  <bp:Protein rdf:ID="Protein87">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-6Y-FRS2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phospho-Frs2-alpha</bp:name>
