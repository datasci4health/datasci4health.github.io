  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction53">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Protein331" />
    <bp:left rdf:resource="#PhysicalEntity33" />
    <bp:right rdf:resource="#Complex257" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PEA15 binds MAPK monomers and dimers</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref1770" />
    <bp:xref rdf:resource="#UnificationXref1771" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PEA15 is a cytoplasmic anchor that binds directly to activated MAPKs prevents their translocation into the nucleus (Formstecher et al, 2001; Whitehurst et al, 2004; Hill et al, 2002; Chou et al, 2003). PEA15 also protects phosphorylated MAPKs in the cytoplasm from inactivating dephosphorylation (Mace et al, 2013).  In this way, binding of PEA15 promotes phosphorylation of cytoplasmic MAPK targets at the expense of nuclear ones.</bp:comment>
    <bp:xref rdf:resource="#PublicationXref242" />
    <bp:xref rdf:resource="#PublicationXref243" />
    <bp:xref rdf:resource="#PublicationXref244" />
    <bp:xref rdf:resource="#PublicationXref245" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2015-02-12</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Roskoski, Robert Jr, 2015-04-28</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2015-02-12</bp:comment>
  </bp:BiochemicalReaction>
