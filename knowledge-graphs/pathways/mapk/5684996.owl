    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S protease regulatory subunit S10B</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proteasome subunit p42</bp:name>
