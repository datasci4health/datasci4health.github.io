  <bp:Protein rdf:ID="Protein60">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARL2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADP-ribosylation factor-like protein 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARL2_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference22" />
    <bp:feature rdf:resource="#FragmentFeature51" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5216230</bp:comment>
    <bp:xref rdf:resource="#UnificationXref330" />
