  <bp:Protein rdf:ID="Protein152">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-LAT-2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-5Y-LAT isoform 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linker for activation of T-cells family member 1 isoform 2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference87" />
    <bp:feature rdf:resource="#ModificationFeature149" />
    <bp:feature rdf:resource="#ModificationFeature150" />
    <bp:feature rdf:resource="#ModificationFeature151" />
