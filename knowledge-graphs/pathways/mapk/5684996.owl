  <bp:ProteinReference rdf:ID="ProteinReference149">
    <bp:organism rdf:resource="#BioSource1" />
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UniProt:P49771 FLT3LG</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLT3LG</bp:name>
    <bp:xref rdf:resource="#UnificationXref1182" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FUNCTION Stimulates the proliferation of early hematopoietic cells by activating FLT3. Synergizes well with a number of other colony stimulating factors and interleukins. Required for the development of B cells, and dendritic cells (DCs).SUBUNIT Homodimer (isoform 2).INTERACTION The disease may be caused by variants affecting the gene represented in this entry.</bp:comment>
  </bp:ProteinReference>
