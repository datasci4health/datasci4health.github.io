  <bp:Protein rdf:ID="Protein395">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUL3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cullin-3</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUL3_HUMAN</bp:name>
