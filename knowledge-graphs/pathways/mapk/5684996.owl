  <bp:Protein rdf:ID="Protein81">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF17-1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibroblast growth factor-17</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGFH_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF17 isoform 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference37" />
