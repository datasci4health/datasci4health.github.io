  <bp:Protein rdf:ID="Protein412">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSMC2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S protease regulatory subunit 7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MSS1 protein</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26S proteasome AAA-ATPase subunit RPT1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference262" />
    <bp:feature rdf:resource="#FragmentFeature358" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 68771</bp:comment>
