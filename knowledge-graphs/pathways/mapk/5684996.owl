  <bp:Protein rdf:ID="Protein137">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p-Y349,Y350-SHC1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phospho-SHC transforming protein</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference80" />
    <bp:feature rdf:resource="#ModificationFeature126" />
    <bp:feature rdf:resource="#ModificationFeature127" />
    <bp:feature rdf:resource="#FragmentFeature114" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 180276</bp:comment>
    <bp:xref rdf:resource="#UnificationXref698" />
