  <bp:Protein rdf:ID="Protein174">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DLG2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSD-93</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disks large homolog 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DLG2_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chapsyn-110</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference104" />
    <bp:feature rdf:resource="#FragmentFeature145" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9610662</bp:comment>
    <bp:xref rdf:resource="#UnificationXref907" />
    <bp:xref rdf:resource="#UnificationXref908" />
