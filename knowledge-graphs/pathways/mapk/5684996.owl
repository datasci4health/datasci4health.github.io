  <bp:Protein rdf:ID="Protein231">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autophosphorylated FLT3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autophosphorylated STK-1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary4" />
    <bp:entityReference rdf:resource="#ProteinReference150" />
