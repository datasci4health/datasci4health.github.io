  <bp:ProteinReference rdf:ID="ProteinReference34">
    <bp:organism rdf:resource="#BioSource1" />
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UniProt:P10767 FGF6</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FGF6</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HST2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HSTF2</bp:name>
    <bp:xref rdf:resource="#UnificationXref404" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FUNCTION Plays an important role in the regulation of cell proliferation, cell differentiation, angiogenesis and myogenesis, and is required for normal muscle regeneration.SUBUNIT Interacts with FGFR1, FGFR2 and FGFR4. Affinity between fibroblast growth factors (FGFs) and their receptors is increased by heparan sulfate glycosaminoglycans that function as coreceptors.INTERACTION Leukemia cell lines with platelet/ megakaryocytic differentiation potential.SIMILARITY Belongs to the heparin-binding growth factors family.</bp:comment>
  </bp:ProteinReference>
